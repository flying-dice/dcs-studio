{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020"],
    "outDir": "out",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  // No `exclude`: `include` already narrows this unit to src/, and the default
  // exclude covers node_modules and outDir. An explicit list here was dead and,
  // being inherited through `extends`, silently subtracted test/ from
  // tsconfig.test.json.
  "include": ["src"]
}
