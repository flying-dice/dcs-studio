# All three vitest configs — only the root one was listed here when the config
# was split into per-layer files, so the other two have been shipping since.
vitest.config.ts
vitest.unit.config.ts
vitest.integration.config.ts
tsconfig.test.json
.vscodeignore
goals/**
biome.json
screenshots/**
ARCHITECTURE.md
# The repo's own sample manifest — a mod project's dcs-studio.toml, not the
# extension's; shipping it puts a stray one inside the installed extension.
dcs-studio.toml
docs/04-quality/**
# Bug reports and RFCs aimed at OUR upstreams (mlua, Eagle Dynamics), not at
# users of this extension. Contributor-facing like 04-quality above: docs/01-03
# are the shipped set, and this file is the only thing that decides that.
docs/05-upstream/**
# RepoDoc's planning surface — this repo's own kanban board and decision
# records. Contributor-facing, like ARCHITECTURE.md above; nothing in the
# extension reads them, so they have no business inside the .vsix.
boards/**
decisions/**
