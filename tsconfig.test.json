{
  // Typecheck-only compilation unit for everything tsconfig.json's `include`
  // leaves out. Vitest and Playwright transpile via esbuild and Biome does not
  // typecheck, so without this the `vscode` test double and the ports it stands
  // in for could drift apart with nothing to notice.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Deliberately off for this unit, where the base turns it on. The flag earns
    // its keep in src/ because an absent index there becomes a wrong value that
    // travels — the marketplace adapter was building a GitHub URL containing
    // "undefined". In test code the same read is an assertion against a fixture
    // or a recorded mock call (`calls[0].opts`, `mock.calls[0][2]`), where an
    // absent element does not travel anywhere: it throws on the spot and fails
    // the test with a stack trace pointing at the line. Enabling it here flagged
    // 468 such reads and not one defect, so it would buy noise and a standing
    // temptation to answer that noise with `!`. Note src/ is inside this unit's
    // `include` too, but `npm run compile` is what governs src/ and it does hold
    // the flag — nothing in src/ is checked more loosely than the base demands.
    "noUncheckedIndexedAccess": false,
    // The base pins rootDir to src/ for the out/ layout; this unit spans the
    // repo and emits nothing, so the constraint has no meaning here.
    "rootDir": ".",
    // The Playwright specs' `page.evaluate` callbacks are authored against the
    // browser realm and need the DOM lib to typecheck at all, and the specs run
    // on Node 20 rather than the base's conservative ES2020 floor — `.at(-1)`
    // and `String.replaceAll` are both already relied on across the suite (the
    // former only worked by way of a transitive `/// <reference lib>` from a
    // dependency, which is not a guarantee to build on). This only widens the
    // globals visible to this unit — `npm run compile` still holds src/ to the
    // base's ES2020-only lib.
    "lib": ["ES2022", "DOM"],
    // Model the loaders that actually run these files rather than the base's
    // CommonJS, which the extension bundle needs but no test file is: `import.meta`
    // is legal here, and `bundler` reads the same package `exports` maps esbuild
    // does — under classic node resolution vitest's config types resolve to a
    // different entry that accepts options the installed vitest has dropped.
    "module": "ES2022",
    "moduleResolution": "bundler"
  },
  "include": ["src", "test", "tests", "*.config.ts"]
}
